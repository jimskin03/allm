+    static std::vector<float> rerankWithoutSampling(
+        rnllama::llama_rn_context * ctx,
+        const std::string & query,
+        const std::vector<std::string> & documents
+    ) {
+        if (ctx->ctx == nullptr || ctx->model == nullptr) {
+            throw std::runtime_error("rerank context is not initialized");
+        }
+        if (llama_pooling_type(ctx->ctx) != LLAMA_POOLING_TYPE_RANK) {
+            throw std::runtime_error("reranking not supported, pooling_type: " + std::to_string((int) llama_pooling_type(ctx->ctx)));
+        }
+        if (!ctx->params.embedding) {
+            throw std::runtime_error("embedding disabled but required for reranking");
+        }
+
+        const llama_vocab * vocab = llama_model_get_vocab(ctx->model);
+        const std::vector<llama_token> query_tokens = tokenizeForRerank(vocab, query);
+        const int32_t n_batch = std::max(1, (int32_t) llama_n_batch(ctx->ctx));
+        const int32_t n_ctx_limit = std::max(1, (int32_t) llama_n_ctx(ctx->ctx));
+        const int32_t max_tokens = std::min(n_batch, n_ctx_limit);
+
+        std::vector<float> scores;
+        scores.reserve(documents.size());
+
+        for (const std::string & document : documents) {
+            std::vector<llama_token> tokens = formatRerankTokens(vocab, query_tokens, tokenizeForRerank(vocab, document));
+            if (tokens.empty()) {
+                scores.push_back(-1e6f);
+                continue;
+            }
+            if ((int32_t) tokens.size() > max_tokens) {
+                tokens.resize((size_t) max_tokens);
+            }
+
+            llama_memory_t mem = llama_get_memory(ctx->ctx);
+            if (mem) {
+                llama_memory_clear(mem, true);
+            }
+
+            llama_batch batch = llama_batch_init((int32_t) tokens.size(), 0, 1);
+            batch.n_tokens = (int32_t) tokens.size();
+            for (int32_t i = 0; i < batch.n_tokens; ++i) {
+                batch.token[i] = tokens[(size_t) i];
+                batch.pos[i] = i;
+                batch.n_seq_id[i] = 1;
+                batch.seq_id[i][0] = 0;
+                // One output is enough for the pooled rank row, and it matches
+                // llama_batch_get_one, which only marks the last token.
+                batch.logits[i] = (i == batch.n_tokens - 1) ? 1 : 0;
+            }
+
+            const int rc = llama_decode(ctx->ctx, batch);
+            llama_batch_free(batch);
+            llama_synchronize(ctx->ctx);
+
+            float score = -1e6f;
+            if (rc == 0) {
+                float * data = llama_get_embeddings_seq(ctx->ctx, 0);
+                if (data == nullptr) {
+                    data = llama_get_embeddings(ctx->ctx);
+                }
+                if (data != nullptr) {
+                    score = data[0];
+                }
+            } else {
+                logError("rerank decode failed: %d", rc);
+            }
+            scores.push_back(score);
+        }
+
+        logInfo("rerank scored %zu documents without sampling", documents.size());
+        return scores;
+    }
