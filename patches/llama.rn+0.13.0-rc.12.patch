+    // Rank-pooling models emit a classification score, not token logits.
+    // llama_rn_context_completion::rerank() still runs the generative sampler,
+    // and common_sampler::set_logits aborts the process on a null logit row
+    // (sampling.cpp GGML_ASSERT). Decode the pair and read the pooled score.
+    static std::vector<llama_token> tokenizeForRerank(const llama_vocab * vocab, const std::string & text) {
+        const int32_t text_len = (int32_t) std::min(text.size(), (size_t) std::numeric_limits<int32_t>::max());
+        int32_t cap = std::max(16, text_len + 16);
+        std::vector<llama_token> tokens((size_t) cap);
+        int32_t n = llama_tokenize(vocab, text.data(), text_len, tokens.data(), cap, false, true);
+        if (n == std::numeric_limits<int32_t>::min()) {
+            throw std::runtime_error("rerank tokenize overflow");
+        }
+        if (n < 0) {
+            cap = -n;
+            tokens.resize((size_t) cap);
+            n = llama_tokenize(vocab, text.data(), text_len, tokens.data(), cap, false, true);
+        }
+        if (n < 0) {
+            throw std::runtime_error("rerank tokenize failed");
+        }
+        tokens.resize((size_t) n);
+        return tokens;
+    }
+
+    // [BOS] query [EOS] [SEP] document [EOS], matching format_rerank_tokens.
+    static std::vector<llama_token> formatRerankTokens(
+        const llama_vocab * vocab,
+        const std::vector<llama_token> & query_tokens,
+        const std::vector<llama_token> & doc_tokens
+    ) {
+        std::vector<llama_token> result;
+        llama_token eos_token = llama_vocab_eos(vocab);
+        if (eos_token == LLAMA_TOKEN_NULL) {
+            eos_token = llama_vocab_sep(vocab);
+        }
+        result.reserve(doc_tokens.size() + query_tokens.size() + 4);
+        if (llama_vocab_get_add_bos(vocab)) {
+            result.push_back(llama_vocab_bos(vocab));
+        }
+        result.insert(result.end(), query_tokens.begin(), query_tokens.end());
+        if (llama_vocab_get_add_eos(vocab) && eos_token != LLAMA_TOKEN_NULL) {
+            result.push_back(eos_token);
+        }
+        if (llama_vocab_get_add_sep(vocab)) {
+            const llama_token sep = llama_vocab_sep(vocab);
+            if (sep != LLAMA_TOKEN_NULL) result.push_back(sep);
+        }
+        result.insert(result.end(), doc_tokens.begin(), doc_tokens.end());
+        if (llama_vocab_get_add_eos(vocab) && eos_token != LLAMA_TOKEN_NULL) {
+            result.push_back(eos_token);
+        }
+        return result;
+    }
